// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carrera {
  CarreraID  Int       @id @default(autoincrement())
  Nombre     String    @db.VarChar(100)
  Estado     String    @default("activo") @db.VarChar(20)
  Created_at DateTime  @default(now())
  Updated_at DateTime  @updatedAt

  usuarios   Usuario[]

  @@map("Carrera")
}

model Recinto {
  RecintoID       Int       @id @default(autoincrement())
  Nombre          String    @db.VarChar(100)
  Latitud         Decimal?  @db.Decimal(10, 8)
  Longitud        Decimal?  @db.Decimal(11, 8)
  HorarioAtencion String?   @db.VarChar(100)
  Estado          String    @default("activo") @db.VarChar(20)
  Created_at      DateTime  @default(now())
  Updated_at      DateTime  @updatedAt

  usuarios        Usuario[]
  avisos          Aviso[]

  @@map("Recinto")
}

model TipoObjeto {
  TipoObjetoID Int      @id @default(autoincrement())
  Nombre       String   @db.VarChar(100)
  Estado       String   @default("activo") @db.VarChar(20)
  Created_at   DateTime @default(now())
  Updated_at   DateTime @updatedAt

  avisos       Aviso[]

  @@map("TipoObjeto")
}

model Usuario {
  UsuarioID           Int       @id @default(autoincrement())
  RecintoID           Int?
  CarreraID           Int?
  Nombre              String    @db.VarChar(60)
  Apellidos           String    @db.VarChar(60)
  Rut                 String    @unique @db.VarChar(12)
  Correo              String    @unique @db.VarChar(254)
  FotoUrl             String?   @db.VarChar(255)
  PasswordHash        String    @db.VarChar(255)
  PasswordTemporal    Boolean   @default(false)
  PasswordExpired_at  DateTime?
  Rol                 String    @db.VarChar(20)
  Estado              String    @default("activo") @db.VarChar(20)
  SegundoFactorActivo Boolean   @default(false)
  IntentosFallidos    Int       @default(0)
  BloqueoHasta_at     DateTime?
  Created_at          DateTime  @default(now())
  Updated_at          DateTime  @updatedAt

  carrera             Carrera?  @relation(fields: [CarreraID], references: [CarreraID])
  recinto             Recinto?  @relation(fields: [RecintoID], references: [RecintoID])
  avisos              Aviso[]

  @@map("Usuario")
}

model Aviso {
  AvisoID          Int        @id @default(autoincrement())
  AlumnoID         Int
  TipoObjetoID     Int
  RecintoID        Int
  AvisoCorregidoID Int?
  Color            String     @db.VarChar(50)
  Descripcion      String     @db.VarChar(500)
  FechaPerdida     DateTime   @db.Date
  FotoUrl          String?    @db.VarChar(255)
  Estado           String     @default("publicado") @db.VarChar(20)
  MotivoCierre     String?    @db.VarChar(100)
  ComentarioCierre String?    @db.VarChar(500)
  Created_at       DateTime   @default(now())
  Updated_at       DateTime   @updatedAt

  alumno           Usuario    @relation(fields: [AlumnoID], references: [UsuarioID])
  tipoObjeto       TipoObjeto @relation(fields: [TipoObjetoID], references: [TipoObjetoID])
  recinto          Recinto    @relation(fields: [RecintoID], references: [RecintoID])
  avisoCorregido   Aviso?     @relation("CorreccionAviso", fields: [AvisoCorregidoID], references: [AvisoID])
  correcciones     Aviso[]    @relation("CorreccionAviso")

  @@map("Aviso")
}
